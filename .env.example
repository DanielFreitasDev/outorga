# Copie para .env (que não é versionado) e ajuste. Detalhes em docs/IA.md.

# Qual IA lê os documentos:
#   llamacpp (padrão, local) | anthropic | openai | gemini | groq | openrouter | deepseek | mistral | together | xai
#   ollama | lmstudio (locais) | compativel (qualquer outra API compatível com a da OpenAI) | nenhum (demonstração)
OUTORGA_LLM=llamacpp

# IA local (llama.cpp / Ollama / LM Studio / vLLM): endereço e nome do modelo no servidor
OUTORGA_LLM_URL=http://127.0.0.1:8089/v1
OUTORGA_LLM_MODELO=qwen3.8-27b

# Chaves de API (preencha só a do serviço escolhido; a chave fica só nesta máquina)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# OUTORGA_LLM_CHAVE=           # para OUTORGA_LLM=compativel (com OUTORGA_LLM_URL)

# Claude (Anthropic): chave ligada ao usuário (sk-ant-usr-...) precisa do ID do workspace (wrkspc_...)
# ANTHROPIC_WORKSPACE_ID=
# Modelo e esforço de raciocínio (low | medium | high | xhigh | max | padrao). Comparação em docs/MODELOS.md
# OUTORGA_CLAUDE_MODELO=claude-sonnet-5-5
# OUTORGA_CLAUDE_ESFORCO=medium
# OUTORGA_CLAUDE_FALLBACK=1     # 0 desliga o repasse de pedidos recusados a outro modelo

# Trava térmica (IA local): pausa acima de MAX °C e retoma abaixo de RETOMAR °C (GPU e CPU)
# OUTORGA_TEMP_MAX=76
# OUTORGA_TEMP_RETOMAR=68
# OUTORGA_TEMP_CPU_MAX=85
# OUTORGA_TEMP_CPU_RETOMAR=75

# Demonstração pública: bloqueia envio de documentos e mudanças de política
# OUTORGA_MODO=demonstracao
